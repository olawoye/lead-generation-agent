{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://olawoye.github.io/lead-generation-agent/schemas/v1/agent-definition.schema.json",
  "title": "AgentDefinition",
  "description": "Platform-agnostic declarative definition of an AI agent. Runtime-independent: no references to Claude, Codex, MCP, or TypeScript.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "Schema version for this definition format.",
      "enum": ["agent.definition/v1"]
    },
    "kind": {
      "type": "string",
      "description": "The kind of definition document.",
      "enum": ["AgentDefinition"]
    },
    "metadata": {
      "$ref": "#/definitions/Metadata"
    },
    "spec": {
      "$ref": "#/definitions/AgentSpec"
    }
  },
  "definitions": {
    "Metadata": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique machine-readable name for this agent.",
          "pattern": "^[a-z0-9-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Human-readable display name."
        },
        "version": {
          "type": "string",
          "description": "Semantic version of this agent definition.",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "AgentSpec": {
      "type": "object",
      "required": ["objective", "orar", "steps"],
      "additionalProperties": false,
      "properties": {
        "objective": {
          "$ref": "#/definitions/Objective"
        },
        "orar": {
          "$ref": "#/definitions/ORAR"
        },
        "state": {
          "$ref": "#/definitions/SharedStateSchema"
        },
        "options": {
          "$ref": "#/definitions/OptionsSchema"
        },
        "policies": {
          "$ref": "#/definitions/Policies"
        },
        "tools": {
          "type": "array",
          "description": "Tool requirements consumed by steps. Runtime resolves these independently.",
          "items": { "$ref": "#/definitions/ToolRequirement" }
        },
        "steps": {
          "type": "array",
          "description": "Ordered list of declarative steps. Runtime determines execution order using dependencies.",
          "minItems": 1,
          "items": { "$ref": "#/definitions/Step" }
        }
      }
    },
    "Objective": {
      "type": "object",
      "required": ["summary", "successCriteria"],
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "description": "One-sentence summary of what this agent achieves."
        },
        "successCriteria": {
          "type": "array",
          "description": "Measurable conditions that define a successful run.",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "context": {
          "type": "string",
          "description": "Additional background context for why this agent exists."
        }
      }
    },
    "ORAR": {
      "type": "object",
      "required": ["objective", "resources", "actions", "results"],
      "additionalProperties": false,
      "description": "Objective-Resources-Actions-Results: structured summary of what the agent does.",
      "properties": {
        "objective": {
          "type": "string",
          "description": "ORAR objective: what the agent is trying to achieve."
        },
        "resources": {
          "type": "array",
          "description": "Inputs and data sources required by the agent.",
          "items": { "type": "string" }
        },
        "actions": {
          "type": "array",
          "description": "High-level actions the agent will perform.",
          "items": { "type": "string" }
        },
        "results": {
          "type": "array",
          "description": "Expected outputs and outcomes of the agent.",
          "items": { "type": "string" }
        }
      }
    },
    "OptionsSchema": {
      "type": "object",
      "description": "Configurable options and their JSON Schema definitions. Allows runtimes to validate user-supplied configuration.",
      "required": ["properties"],
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": { "type": "string" }
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/OptionProperty"
          }
        }
      }
    },
    "OptionProperty": {
      "type": "object",
      "required": ["type", "description"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "integer", "boolean", "array", "object"]
        },
        "description": {
          "type": "string"
        },
        "default": {},
        "enum": {
          "type": "array"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "items": {
          "type": "object"
        }
      }
    },
    "SharedStateSchema": {
      "type": "object",
      "required": ["dedupeKeys", "leadRecord"],
      "additionalProperties": false,
      "description": "The normalized execution state used across the workflow. Records are progressively enriched and deduplicated rather than treated as disconnected lists.",
      "properties": {
        "dedupeKeys": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Fields used to deduplicate records across steps, such as domain, email, or company_name."
        },
        "leadRecord": {
          "type": "object",
          "required": ["type", "properties"],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": ["object"]
            },
            "properties": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/SharedStateField"
              }
            }
          }
        },
        "finalLeadOutput": {
          "type": "object",
          "description": "Optional schema for the final aggregated lead output.",
          "additionalProperties": true
        }
      }
    },
    "SharedStateField": {
      "type": "object",
      "required": ["type", "description"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": false
        },
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Policies": {
      "type": "object",
      "additionalProperties": false,
      "description": "Declarative policies governing agent behaviour. Runtimes must enforce these.",
      "properties": {
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum number of retries per step on transient failure."
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum wall-clock seconds allowed for the entire agent run."
        },
        "rateLimiting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requestsPerMinute": { "type": "integer", "minimum": 1 },
            "concurrentSteps": { "type": "integer", "minimum": 1 }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maskPII": {
              "type": "boolean",
              "description": "Whether PII must be masked in logs and outputs."
            },
            "retentionDays": {
              "type": "integer",
              "minimum": 0,
              "description": "How many days intermediate results may be retained."
            }
          }
        },
        "errorHandling": {
          "type": "string",
          "enum": ["fail-fast", "continue-on-error", "rollback"],
          "description": "How the runtime handles step-level errors."
        }
      }
    },
    "ToolRequirement": {
      "type": "object",
      "required": ["id", "description", "capabilities"],
      "additionalProperties": false,
      "description": "A logical tool the agent needs. Runtimes map this to a concrete implementation.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique tool identifier used to reference the tool from steps.",
          "pattern": "^[a-z0-9-_]+$"
        },
        "description": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "description": "Abstract capability tags runtimes use to resolve implementations.",
          "items": { "type": "string" },
          "minItems": 1
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "If true, the agent can still run without this tool (degraded mode)."
        }
      }
    },
    "Step": {
      "type": "object",
      "required": ["id", "name", "description", "inputs", "outputs"],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique step identifier. Used in dependsOn references.",
          "pattern": "^[a-z0-9-_]+$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "What this step does. Runtime uses this as the prompt/instruction seed."
        },
        "enabled": {
          "type": "boolean",
          "description": "Whether this step is active in the workflow. Disabled steps are skipped by the runtime.",
          "default": true
        },
        "objective": {
          "description": "Declarative objective for the step. Can be a short string or a structured object.",
          "oneOf": [
            { "type": "string" },
            { "$ref": "#/definitions/StepObjective" }
          ]
        },
        "dependsOn": {
          "type": "array",
          "description": "IDs of steps that must complete before this step can run.",
          "items": { "type": "string" },
          "default": []
        },
        "tools": {
          "type": "array",
          "description": "Tool IDs from spec.tools used in this step.",
          "items": { "type": "string" },
          "default": []
        },
        "inputs": {
          "description": "Declared inputs for this step. Can be an ordered string array or an object keyed by input name.",
          "oneOf": [
            {
              "type": "array",
              "items": { "type": "string" }
            },
            {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/IOProperty" }
            }
          ]
        },
        "outputs": {
          "description": "Declared outputs for this step. Can be an ordered string array or an object keyed by output name.",
          "oneOf": [
            {
              "type": "array",
              "items": { "type": "string" }
            },
            {
              "type": "object",
              "additionalProperties": { "$ref": "#/definitions/IOProperty" }
            }
          ]
        },
        "configuration": {
          "type": "object",
          "description": "Step-specific runtime configuration values.",
          "additionalProperties": true
        },
        "next_steps": {
          "type": "array",
          "description": "Explicit downstream steps that may follow this step when execution succeeds.",
          "items": { "type": "string" }
        },
        "quality_rules": {
          "type": "array",
          "description": "Rules that validate the step output before it can proceed to the next step.",
          "items": { "$ref": "#/definitions/QualityRule" }
        },
        "retry_policy": {
          "$ref": "#/definitions/RetryPolicy"
        },
        "policy": {
          "$ref": "#/definitions/StepPolicy"
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "StepObjective": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "summary": { "type": "string" },
        "details": { "type": "string" },
        "measurable": { "type": "string" },
        "sources": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "QualityRule": {
      "type": "object",
      "required": ["rule"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "rule": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "info"]
        },
        "message": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "RetryPolicy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "max_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "backoff_ms": {
          "type": "integer",
          "minimum": 0
        },
        "backoff_multiplier": {
          "type": "number",
          "minimum": 1
        },
        "max_backoff_ms": {
          "type": "integer",
          "minimum": 0
        },
        "retry_on": {
          "type": "array",
          "items": { "type": "string" }
        },
        "do_not_retry_on": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "IOProperty": {
      "type": "object",
      "required": ["type", "description"],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "source": {
          "type": "string",
          "description": "For inputs: reference to output of a prior step using 'stepId.outputName' notation."
        }
      }
    },
    "StepPolicy": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-step policy overrides.",
      "properties": {
        "maxRetries": {
          "type": "integer",
          "minimum": 0
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "cacheResults": {
          "type": "boolean",
          "description": "Whether the runtime may cache and reuse the output of this step."
        }
      }
    }
  }
}
