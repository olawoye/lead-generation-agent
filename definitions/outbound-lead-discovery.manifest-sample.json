{
  "apiVersion": "agent.manifest/v1",
  "kind": "RuntimeManifest",
  "metadata": {
    "name": "outbound-lead-discovery-sample",
    "displayName": "Outbound Lead Discovery Sample Manifest",
    "version": "1.0.0",
    "description": "Minimal SaaS-side MCP server manifest for the outbound lead discovery workflow. This is a sample contract for app-level runtime wiring and is intentionally independent from the declarative workflow definition."
  },
  "runtime": {
    "orchestrator": "lead-generation-runtime-typescript",
    "executionModel": "stateless",
    "persistenceOwner": "saas-app",
    "notes": [
      "The runtime remains stateless and emits lifecycle events and checkpoints.",
      "The SaaS app owns durable persistence, retries, tenancy state, and resume semantics.",
      "This manifest is a deployment-time configuration artifact, not a workflow definition."
    ]
  },
  "workflow": {
    "definitionRef": "definitions/outbound-lead-discovery.v1.0.0.yaml",
    "scenario": "crm-lead-generation",
    "stepToolMap": [
      { "stepId": "search_engine_prospecting", "requiredTools": ["web_search"] },
      { "stepId": "directory_mining", "requiredTools": ["company_directory_search", "maps_search_places"] },
      { "stepId": "public_data_prospecting", "requiredTools": ["public_records_search"] },
      { "stepId": "marketplace_prospecting", "requiredTools": ["web_search"] },
      { "stepId": "website_technology_discovery", "requiredTools": ["website_content_research", "detect_technologies"] },
      { "stepId": "geographic_territory_prospecting", "requiredTools": ["maps_search_places"] },
      { "stepId": "competitive_intelligence_prospecting", "requiredTools": ["web_news_search"] },
      { "stepId": "event_community_prospecting", "requiredTools": ["events_search"] },
      { "stepId": "intent_trigger_based_prospecting", "requiredTools": ["signal_monitoring"] },
      { "stepId": "lead_enrichment_qualification", "requiredTools": ["enrich_company", "enrich_person", "lead_scoring", "crm_upsert_lead"] }
    ]
  },
  "servers": [
    {
      "name": "web-search",
      "transport": "http",
      "status": "ready",
      "url": "${saas.generated.url}",
      "startup": {
        "mode": "spawn",
        "command": "node",
        "args": ["dist/index.js"],
        "env": {
          "MCP_HOST": "${saas.generated.host}",
          "MCP_PORT": "${saas.generated.port}"
        },
        "healthCheck": {
          "path": "/health",
          "method": "GET",
          "expectedStatus": 200
        }
      },
      "tools": [
        "web_search",
        "web_news_search"
      ],
      "capabilities": [
        "web-search",
        "news-search"
      ],
      "credentials": [
        "MT_PROVIDER_SERP_URL",
        "MT_PROVIDER_SERP_KEY"
      ],
      "credentialRef": "secret://tenants/${tenantId}/web-search/serpapi",
      "notes": [
        "The SaaS app generates the bind host and bind port at runtime for each server instance. It injects those values into the spawned process via MCP_HOST and MCP_PORT, then records the final reachable URL for the server entry. Provider secrets remain in the credential model and are resolved by the server itself from the environment or tenant secret layer; they are not injected through startup.env unless they are runtime-specific overrides."
      ]
    },
    {
      "name": "maps",
      "transport": "http",
      "status": "ready",
      "url": "${saas.generated.url}",
      "startup": {
        "mode": "spawn",
        "command": "node",
        "args": ["dist/index.js"],
        "env": {
          "MCP_HOST": "${saas.generated.host}",
          "MCP_PORT": "${saas.generated.port}"
        },
        "healthCheck": {
          "path": "/health",
          "method": "GET",
          "expectedStatus": 200
        }
      },
      "tools": [
        "maps_search_places",
        "maps_nearby_search"
      ],
      "capabilities": [
        "maps-search",
        "geo-search"
      ],
      "credentials": [
        "MT_PROVIDER_OSM_URL"
      ],
      "credentialRef": "secret://tenants/${tenantId}/maps/openstreetmap",
      "notes": [
        "The SaaS app generates the bind host and bind port at runtime for each server instance. It injects those values via MCP_HOST and MCP_PORT, then records the final reachable URL. Provider configuration remains in the credential model unless a launch-specific override is intentionally required."
      ]
    },
    {
      "name": "business-directories",
      "transport": "http",
      "status": "ready",
      "url": "${saas.generated.url}",
      "startup": {
        "mode": "spawn",
        "command": "node",
        "args": ["dist/index.js"],
        "env": {
          "MCP_HOST": "${saas.generated.host}",
          "MCP_PORT": "${saas.generated.port}"
        },
        "healthCheck": {
          "path": "/health",
          "method": "GET",
          "expectedStatus": 200
        }
      },
      "tools": [
        "company_directory_search",
        "person_directory_search",
        "business_listing_lookup"
      ],
      "capabilities": [
        "business-directory",
        "company-discovery",
        "person-directory"
      ],
      "credentials": [],
      "credentialRef": "none",
      "notes": [
        "This package is a local directory-source catalog and remains stateless. It exposes a runnable HTTP entrypoint with the same runtime contract as the other toolkit servers, while keeping directory credentials and provider values out of the startup.env contract."
      ]
    },
    {
      "name": "public-data",
      "transport": "http",
      "status": "ready",
      "url": "${saas.generated.url}",
      "startup": {
        "mode": "spawn",
        "command": "node",
        "args": ["dist/index.js"],
        "env": {
          "MCP_HOST": "${saas.generated.host}",
          "MCP_PORT": "${saas.generated.port}"
        },
        "healthCheck": {
          "path": "/health",
          "method": "GET",
          "expectedStatus": 200
        }
      },
      "tools": [
        "public_records_search",
        "registry_lookup"
      ],
      "capabilities": [
        "public-record-search",
        "business-registry"
      ],
      "credentials": [],
      "credentialRef": "none",
      "notes": [
        "This server remains a local public-data catalog until a real registry provider is attached. It is still executable with the toolkit's standard runtime contract and does not require runtime-only secrets in startup.env."
      ]
    },
    {
      "name": "website-research",
      "transport": "http",
      "status": "ready",
      "url": "${saas.generated.url}",
      "startup": {
        "mode": "spawn",
        "command": "node",
        "args": ["dist/index.js"],
        "env": {
          "MCP_HOST": "${saas.generated.host}",
          "MCP_PORT": "${saas.generated.port}"
        },
        "healthCheck": {
          "path": "/health",
          "method": "GET",
          "expectedStatus": 200
        }
      },
      "tools": [
        "website_content_research",
        "website_technology_scan"
      ],
      "capabilities": [
        "website-analysis",
        "content-scrape",
        "technology-detection"
      ],
      "credentials": [],
      "credentialRef": "none",
      "notes": [
        "This package is executable and follows the same direct-run HTTP contract as the other active servers; it is still a local analysis catalog and does not require startup.env provider values."
      ]
    },
    {
      "name": "technology-detection",
      "transport": "http",
      "status": "ready",
      "url": "${saas.generated.url}",
      "startup": {
        "mode": "spawn",
        "command": "node",
        "args": ["dist/index.js"],
        "env": {
          "MCP_HOST": "${saas.generated.host}",
          "MCP_PORT": "${saas.generated.port}"
        },
        "healthCheck": {
          "path": "/health",
          "method": "GET",
          "expectedStatus": 200
        }
      },
      "tools": [
        "detect_technologies"
      ],
      "capabilities": [
        "technology-detection"
      ],
      "credentials": [
        "MT_PROVIDER_BUILTWITH_URL",
        "MT_PROVIDER_BUILTWITH_KEY"
      ],
      "credentialRef": "secret://tenants/${tenantId}/technology-detection/builtwith",
      "notes": [
        "The SaaS app generates a bind host and port at runtime, then resolves the final URL from those values. The BuiltWith provider URL and key remain in the credential model and are consumed by the server, not passed via startup.env by default."
      ]
    },
    {
      "name": "events",
      "transport": "http",
      "status": "ready",
      "url": "${saas.generated.url}",
      "startup": {
        "mode": "spawn",
        "command": "node",
        "args": ["dist/index.js"],
        "env": {
          "MCP_HOST": "${saas.generated.host}",
          "MCP_PORT": "${saas.generated.port}"
        },
        "healthCheck": {
          "path": "/health",
          "method": "GET",
          "expectedStatus": 200
        }
      },
      "tools": [
        "events_search",
        "signal_monitoring"
      ],
      "capabilities": [
        "event-discovery",
        "trigger-monitoring"
      ],
      "credentials": [
        "MT_PROVIDER_EVENTBRITE_URL",
        "MT_PROVIDER_EVENTBRITE_KEY"
      ],
      "credentialRef": "secret://tenants/${tenantId}/events/eventbrite",
      "notes": [
        "Eventbrite is used as the concrete provider for event lookup and signal monitoring. The SaaS app allocates the bind host and port at runtime, while Eventbrite credentials remain in the credential model and are resolved by the server process itself."
      ]
    },
    {
      "name": "enrichment",
      "transport": "http",
      "status": "ready",
      "url": "${saas.generated.url}",
      "startup": {
        "mode": "spawn",
        "command": "node",
        "args": ["dist/index.js"],
        "env": {
          "MCP_HOST": "${saas.generated.host}",
          "MCP_PORT": "${saas.generated.port}"
        },
        "healthCheck": {
          "path": "/health",
          "method": "GET",
          "expectedStatus": 200
        }
      },
      "tools": [
        "enrich_company",
        "enrich_person"
      ],
      "capabilities": [
        "company-enrichment",
        "person-enrichment"
      ],
      "credentials": [
        "MT_PROVIDER_APOLLO_URL",
        "MT_PROVIDER_APOLLO_KEY"
      ],
      "credentialRef": "secret://tenants/${tenantId}/enrichment/apollo",
      "notes": [
        "The SaaS app allocates the bind host and port at runtime, starts the server with those values, and records the final URL. Provider config remains in the credential model and is resolved by the server itself."
      ]
    },
    {
      "name": "company-intelligence",
      "transport": "http",
      "status": "ready",
      "url": "${saas.generated.url}",
      "startup": {
        "mode": "spawn",
        "command": "node",
        "args": ["dist/index.js"],
        "env": {
          "MCP_HOST": "${saas.generated.host}",
          "MCP_PORT": "${saas.generated.port}"
        },
        "healthCheck": {
          "path": "/health",
          "method": "GET",
          "expectedStatus": 200
        }
      },
      "tools": [
        "lead_scoring"
      ],
      "capabilities": [
        "lead-scoring",
        "prioritization"
      ],
      "credentials": [],
      "credentialRef": "none",
      "notes": [
        "Local lead scoring does not need a provider secret; it uses deterministic in-process weights and is fully stateless. The SaaS app starts it on a dynamic host/port and records the URL returned by that instance."
      ]
    },
    {
      "name": "crm",
      "transport": "http",
      "status": "ready",
      "url": "${saas.generated.url}",
      "startup": {
        "mode": "spawn",
        "command": "node",
        "args": ["dist/index.js"],
        "env": {
          "MCP_HOST": "${saas.generated.host}",
          "MCP_PORT": "${saas.generated.port}"
        },
        "healthCheck": {
          "path": "/health",
          "method": "GET",
          "expectedStatus": 200
        }
      },
      "tools": [
        "crm_upsert_lead"
      ],
      "capabilities": [
        "lead-write",
        "contact-write",
        "activity-write"
      ],
      "credentials": [
        "MT_CUSTOM_CRM_API_URL",
        "MT_CUSTOM_CRM_API_KEY",
        "MT_CUSTOM_CRM_TENANT_ID",
        "MT_CUSTOM_CRM_AGENT_KEY"
      ],
      "notes": [
        "The SaaS app provides the CRM base URL, API key, tenant ID, and agent key before invoking the upsert endpoint. The tool sends the payload directly to the configured full endpoint path, while the bind host/port for the local CRM MCP server is allocated at runtime by the SaaS app."
      ]
    }
  ],
  "minimalScenarioSet": {
    "summary": "The minimum viable tool set for this flow is web search, maps, enrichment, technology detection, event discovery, lead scoring, and CRM writeback. The remaining directories/public-data sources are optional but recommended for the broader outbound lead-discovery workflow.",
    "required": [
      "web_search",
      "maps_search_places",
      "website_content_research",
      "detect_technologies",
      "enrich_company",
      "enrich_person",
      "lead_scoring",
      "crm_upsert_lead"
    ],
    "recommended": [
      "company_directory_search",
      "public_records_search",
      "events_search",
      "signal_monitoring",
      "web_news_search"
    ]
  }
}
