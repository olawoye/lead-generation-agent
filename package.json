{
  "name": "@olawoye/lead-generation-agent-definition",
  "version": "1.0.0",
  "description": "Platform-agnostic declarative definition of the outbound lead-discovery AI agent",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "definitions",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "validate": "ts-node src/validate.ts",
    "test": "jest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "agent",
    "ai",
    "lead-generation",
    "declarative",
    "platform-agnostic"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  }
}
